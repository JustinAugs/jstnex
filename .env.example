# ============================================================
# JSTNEX — Environment Variables Template
# ============================================================
#
# 怎么用：
#   1. 复制这个文件，命名为 .env.local
#        cp .env.example .env.local
#   2. 把真正的值填进 .env.local（这一列现在全是空的）
#   3. .env.local 已经在 .gitignore 里，永远不会被提交
#
# 绝对不要做的事：
#   - 不要把真实的值填进本文件（本文件是要推到 GitHub 的，仓库是 Public）
#   - 不要把密钥写进 app/ components/ data/*.json 里
#   - 不要截图、不要把 .env.local 的内容发给别人
#
# 关于 NEXT_PUBLIC_ 前缀（重要）：
#   带 NEXT_PUBLIC_ 的变量会被打包进浏览器代码，任何人打开网页按 F12 都能看到。
#   只用它放「本来就可以公开」的东西（比如网站地址）。
#   真正的密钥一律不加前缀 —— 那样它只存在于服务器端。
#
# 什么时候才需要这些变量？
#   下面每一项都标了对应的阶段，现阶段（Foundation / V1.0）一个都不用填。
# ============================================================


# ---------- Site ----------

# 网站的公开地址。本地开发不用填；上线后填 https://你的域名
# 这个变量本来就是公开信息，所以允许 NEXT_PUBLIC_
NEXT_PUBLIC_SITE_URL=


# ---------- Database（V2：PostgreSQL）----------

# 数据库连接串，例如 postgresql://user:password@localhost:5432/jstnex
DATABASE_URL=


# ---------- AI（V3：JSTNEX AI）----------

# 大模型服务的密钥。注意没有 NEXT_PUBLIC_ 前缀 —— 它只能留在服务器端
OPENAI_API_KEY=

# 如果换成别的供应商，用这个变量指定服务地址（可留空用默认）
OPENAI_BASE_URL=


# ---------- External Data（V2+：贸易数据、航运数据）----------

# 外部数据接口的密钥
API_KEY=

# 外部数据接口的地址
API_BASE_URL=
